# Every URL, image and version the Passport skills depend on, in production.
# Edit shared/urls.env, then run tools/sync-shared.sh.
PASSPORT_APP_URL=https://app.usepassport.ai
PASSPORT_API_URL=https://api.usepassport.ai
PASSPORT_JWKS_URL=https://api.usepassport.ai/api/v1/bundles/.well-known/jwks.json
PASSPORT_DOCS_URL=https://docs.usepassport.ai
PASSPORT_CLI_INSTALLER=https://dl-passport.pstmn.io/install/enterprise/unix.sh
PASSPORT_CLI_MIN_VERSION=0.9.5
# A Proxy release, pinned so every setup runs the same Proxy.
PASSPORT_PROXY_IMAGE=public.ecr.aws/q4k6e3c0/passport/passport-proxy:v0.14.0
PASSPORT_VAULT_IMAGE=hashicorp/vault:2.2.1
PASSPORT_DEMO_API_HOST=passport-skill-demo.mock.postman.postman.dev
