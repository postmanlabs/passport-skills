# Configuration for your Passport Proxy, read by Docker (docker run --env-file).
# The setup filled in everything except the two values marked YOU FILL IN.
# Lines starting with # are comments. Keep each value on one line, no quotes.

# --- YOU FILL IN ---------------------------------------------------------------
# Copy both from the Proxy Configuration you create in the Passport app.
PASSPORT_PROXY_ID=
# The enrollment token. Secret: paste it here only.
PASSPORT_PROXY_TOKEN=

# --- Passport Cloud ------------------------------------------------------------
# Lets the Proxy call Passport Cloud; without true it never registers.
PASSPORT_PROXY_HEARTBEAT_ENABLED=true
# Where the Proxy registers and fetches the rules for your team.
PASSPORT_CONTROL_PLANE_URL=
# Public keys used to check the certificates the Passport CLI presents.
PASSPORT_PROXY_JWKS_URL=
# Only people in your team may use this Proxy. Filled in from your API key.
PASSPORT_PROXY_ALLOWED_TEAM_IDS=

# --- How your tools reach the Proxy -------------------------------------------
# The Proxy tells Passport Cloud these addresses; the CLI finds them at sign-in.
PASSPORT_PROXY_PUBLIC_URL=
PASSPORT_PROXY_PUBLIC_MANAGEMENT_URL=
# Names the Proxy's TLS certificate is valid for.
PASSPORT_PROXY_DATAPLANE_CERT_SANS=localhost,passport-proxy.localhost

# --- The Proxy's private keys -------------------------------------------------
# Made once with openssl in ~/.passport/onboarding/keys and mounted read-only.
# ca.pem signs client certificates; ref.pem decrypts Secret References.
# Never regenerate ref.pem: every Secret Reference made for it would stop working.
PASSPORT_PROXY_PRIVATE_KEY_PATH=/keys/ca.pem
PASSPORT_PROXY_REFERENCE_PRIVATE_KEY_PATH=/keys/ref.pem

# --- Secret Vault (HashiCorp) ------------------------------------------------
# Where the real secret values live. The Proxy reads them here and swaps them
# in for {{vault:<id>}} on the way out.
PASSPORT_PROXY_VAULT_SOURCE=hashicorp
VAULT_ADDR=
# The root token of your local Secret Vault (HashiCorp). You also sign in to
# its UI with it. In production, the Proxy gets its own read-only token instead.
VAULT_TOKEN=

# --- Proxy console ---------------------------------------------------------------
# A web page with this Proxy's audit log and reports, at <management URL>/console.
#   Username: admin
#   Password: passport-local
# These are fixed, publicly known values; the console only listens on this
# machine (127.0.0.1). For your own password, replace the hash below with a
# bcrypt hash of it:
#   htpasswd -nbBC 10 admin 'your-password' | cut -d: -f2
PASSPORT_PROXY_CONSOLE_USER=admin
PASSPORT_PROXY_CONSOLE_PASSWORD_HASH=$2a$10$fBx3rhPZC5zdaQis0tl1yu2vpio4.zINVvx3rOnvU0rxJzaYsoTRu

# --- Audit log -------------------------------------------------------------------
# Every allowed or refused request is written to an audit file on this machine,
# ~/.passport/onboarding/audit/audit.jsonl. The Proxy console shows it.
# PASSPORT_PROXY_AUDIT_READER_FILE=1 lets the console read that file.
PASSPORT_PROXY_AUDIT_SINK=file
PASSPORT_PROXY_AUDIT_FILE_PATH=/audit/audit.jsonl
PASSPORT_PROXY_AUDIT_READER_FILE=1
