# Every URL, image and version the Passport skills depend on.
# Beta values for now; swap to production before publishing.
# Edit shared/urls.env, then run tools/sync-shared.sh.
PASSPORT_APP_URL=https://app.usepassport-beta.ai
PASSPORT_API_URL=https://api.usepassport-beta.ai
PASSPORT_JWKS_URL=https://api.usepassport-beta.ai/api/v1/bundles/.well-known/jwks.json
PASSPORT_DOCS_URL=https://docs.usepassport.ai
PASSPORT_CLI_INSTALLER=https://dl-passport.pstmn-beta.io/install/enterprise/unix.sh
PASSPORT_CLI_MIN_VERSION=0.9.4
# A fixed tag, rebuilt from the Proxy repo's channel/beta and pushed over the same name.
PASSPORT_PROXY_IMAGE=public.ecr.aws/q4k6e3c0/passport/passport-proxy:onboarding-beta
PASSPORT_VAULT_IMAGE=hashicorp/vault:2.2.1
PASSPORT_DEMO_API_HOST=passport-skill-demo.mock.postman.postman.dev
