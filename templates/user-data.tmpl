#!/bin/bash
# First-boot bootstrap for the Passport proxy host. Contains NO secrets:
#  - generates the proxy's bootstrap keys ON the instance (kept on its disk, survive container restarts)
#  - starts a local HashiCorp Vault (dev mode, in memory) — the only secret backend for API credentials
#  - installs helper scripts; the proxy itself is started later by the user, after an interactive
#    `docker login` (the registry key never passes through user-data, SSM parameters or chat)
set -euo pipefail
exec > >(tee /var/log/passport-bootstrap.log) 2>&1
# no `set -x`: it would copy the Vault token into this log and the EC2 console output

ORG=__ORG__
SANS=__SANS__

dnf -y -q install docker jq openssl
systemctl enable --now docker

install -d -m 0755 /opt/passport
install -d -m 0711 /opt/passport/keys          # traversable, not listable, by the proxy's non-root user

# --- proxy bootstrap keys (on disk, never in AWS) ----------------------------------------------
# Only created if missing, so a reboot or re-run never replaces them (replacing ref.pem would break
# every secret reference registered for this proxy).
umask 077
[ -s /opt/passport/keys/ca.pem ]  || openssl genrsa -out /opt/passport/keys/ca.pem 2048
[ -s /opt/passport/keys/ref.pem ] || openssl genrsa -out /opt/passport/keys/ref.pem 2048
openssl rsa -in /opt/passport/keys/ref.pem -pubout -out /opt/passport/reference-public-key.pem 2>/dev/null
chmod 0644 /opt/passport/reference-public-key.pem   # public half: this is what gets registered with Passport Cloud

# --- proxy settings (no secrets) ----------------------------------------------------------------
cat > /opt/passport/proxy.conf << EOF
ORG=$ORG
SANS=$SANS
IMAGE=ociregistry.usepassport.ai/passport/passport-proxy:latest
EOF
chmod 0644 /opt/passport/proxy.conf

# --- local HashiCorp Vault: dev mode, IN MEMORY — API credentials are lost if this container restarts --
[ -s /opt/passport/vault.env ] || printf 'VAULT_TOKEN=%s\n' "$(openssl rand -hex 24)" > /opt/passport/vault.env
chmod 0600 /opt/passport/vault.env
docker network inspect pp-net >/dev/null 2>&1 || docker network create pp-net
. /opt/passport/vault.env
docker rm -f pp-vault-dev >/dev/null 2>&1 || true
docker run -d --name pp-vault-dev --restart unless-stopped --network pp-net --cap-add=IPC_LOCK \
  -e VAULT_DEV_ROOT_TOKEN_ID="$VAULT_TOKEN" -e VAULT_DEV_LISTEN_ADDRESS=0.0.0.0:8200 \
  hashicorp/vault:1.17.6 server -dev >/dev/null
unset VAULT_TOKEN

# --- helper: start (or restart) the proxy. Run by the user after `sudo docker login`. ---
cat > /usr/local/bin/passport-start-proxy << 'SH'
#!/bin/bash
# Usage: sudo passport-start-proxy      (after: sudo docker login ociregistry.usepassport.ai --username passport)
# Starts (or restarts) the proxy. It trusts the public CAs built into its image, so public HTTPS APIs work as-is.
set -euo pipefail
. /opt/passport/proxy.conf
docker pull "$IMAGE"
docker logout ociregistry.usepassport.ai >/dev/null 2>&1 || true    # don't keep the registry key on disk after the pull
# Give the proxy's non-root user read access to its keys, and nobody else. The image may name its user
# ("nonroot:nonroot" today), so resolve the name to a UID from the image's own /etc/passwd.
U="$(docker image inspect -f '{{.Config.User}}' "$IMAGE")"; UNAME="${U%%:*}"; KUID=""
case "$UNAME" in
  ''|root|0) echo "image runs as root; keys stay 0600 root";;
  *[!0-9]*) C="$(docker create "$IMAGE")"
            KUID="$(docker cp "$C":/etc/passwd - 2>/dev/null | tar -xO 2>/dev/null | awk -F: -v u="$UNAME" '$1==u{print $3}')"
            docker rm "$C" >/dev/null;;
  *) KUID="$UNAME";;
esac
if [ -n "$KUID" ]; then
  chown "$KUID" /opt/passport/keys/ca.pem /opt/passport/keys/ref.pem; chmod 0400 /opt/passport/keys/ca.pem /opt/passport/keys/ref.pem
  echo "keys readable only by UID $KUID ($UNAME)"
elif [ -n "$UNAME" ] && [ "$UNAME" != root ] && [ "$UNAME" != 0 ]; then
  echo "could not resolve image user '$UNAME'; making keys world-readable (no SSH, single-purpose host)"
  chmod 0644 /opt/passport/keys/ca.pem /opt/passport/keys/ref.pem
fi
docker rm -f pp-proxy-local >/dev/null 2>&1 || true
docker run -d --name pp-proxy-local --restart unless-stopped --network pp-net -p 8443:8443 -p 8081:8081 \
  -v /opt/passport:/opt/passport:ro \
  -e PASSPORT_PROXY_PRIVATE_KEY_PATH=/opt/passport/keys/ca.pem \
  -e PASSPORT_PROXY_REFERENCE_PRIVATE_KEY_PATH=/opt/passport/keys/ref.pem \
  -e PASSPORT_PROXY_JWKS_URL=https://api.usepassport.ai/api/v1/bundles/.well-known/jwks.json \
  -e PASSPORT_PROXY_ALLOWED_TEAM_IDS="$ORG" \
  -e PASSPORT_PROXY_AUDIT_SINK=stdout \
  -e PASSPORT_PROXY_DATAPLANE_CERT_SANS="$SANS" \
  -e PASSPORT_PROXY_VAULT_SOURCE=hashicorp \
  -e VAULT_ADDR=http://pp-vault-dev:8200 \
  --env-file /opt/passport/vault.env \
  "$IMAGE" >/dev/null
sleep 5
docker ps --format '{{.Names}}\t{{.Status}}' | grep '^pp-'
code="$(curl -s -o /dev/null -w '%{http_code}' http://localhost:8081/readyz || true)"
echo "readyz=$code"; [ "$code" = 200 ]
SH

# --- helper: store an API credential in Vault from a HIDDEN prompt (value never on the command line) ---
cat > /usr/local/bin/passport-vault-put << 'SH'
#!/bin/bash
# Usage: sudo passport-vault-put <vault-key>       e.g.  sudo passport-vault-put example-api-token
set -euo pipefail
KEY="${1:?usage: passport-vault-put <vault-key>}"
case "$KEY" in *[!A-Za-z0-9._/-]*|/*|*..*) echo "invalid key name: $KEY" >&2; exit 2;; esac
read -rsp "Value for secret/$KEY (input hidden): " VAL; echo
[ -n "$VAL" ] || { echo "empty value, nothing stored" >&2; exit 1; }
. /opt/passport/vault.env
printf '%s' "$VAL" | docker exec -i -e VAULT_ADDR=http://127.0.0.1:8200 -e VAULT_TOKEN="$VAULT_TOKEN" pp-vault-dev \
  vault kv put "secret/$KEY" value=- >/dev/null
unset VAL VAULT_TOKEN
echo "stored secret/$KEY  (vaultKey for the Passport secret reference: $KEY)"
SH

# --- helper: sha256 of a stored value, to verify without printing it ---------------------------------
cat > /usr/local/bin/passport-vault-sha256 << 'SH'
#!/bin/bash
set -euo pipefail
KEY="${1:?usage: passport-vault-sha256 <vault-key>}"
. /opt/passport/vault.env
V="$(docker exec -e VAULT_ADDR=http://127.0.0.1:8200 -e VAULT_TOKEN="$VAULT_TOKEN" pp-vault-dev \
  vault kv get -field=value "secret/$KEY")" || { echo "could not read secret/$KEY (lost after a Vault restart?)" >&2; exit 1; }
printf '%s' "$V" | sha256sum | awk '{print $1}'; unset V
SH
chmod 0755 /usr/local/bin/passport-start-proxy /usr/local/bin/passport-vault-put /usr/local/bin/passport-vault-sha256

echo "passport-bootstrap: done (proxy not started yet: run 'sudo docker login …' then 'sudo passport-start-proxy')"
